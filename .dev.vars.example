# Nexus Environment Configuration
# Copy this file to .dev.vars for local development
# Set production secrets via: wrangler secret put SECRET_NAME

# JWT signing secret (REQUIRED for production)
JWT_SECRET=change-me-in-production

# Environment
ENVIRONMENT=development

# Auth provider: mock | email | oauth
AUTH_PROVIDER=mock

# AI provider: mock | openai | anthropic | google
AI_PROVIDER=mock

# AI API key (only needed if AI_PROVIDER is not mock)
# Set via: wrangler secret put AI_API_KEY
# AI_API_KEY=

# Database
# D1 database ID is configured in wrangler.toml
